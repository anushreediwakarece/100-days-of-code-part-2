{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Debug current C++ file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "cwd": "${fileDirname}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\MinGW\\bin\\gdb.exe",
      "preLaunchTask": "Build C++ file",
      "externalConsole": false
    }
  ]
}